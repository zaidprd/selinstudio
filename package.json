{
  "name": "selin-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Studio video affiliate syar'i (faceless & SFX-only) untuk niche teknologi dan peralatan rumah tangga dengan BYOK Base URL dan FFmpeg lokal.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n UI,RENDER -c cyan,green \"vite\" \"node server/render-server.mjs\"",
    "dev:ui": "vite",
    "dev:render": "node server/render-server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}

